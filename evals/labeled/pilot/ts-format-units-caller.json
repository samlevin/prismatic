  "pullRequest": {
    "title": "Format currency with Intl.NumberFormat",
    "body": "Switches formatUsd to Intl.NumberFormat and adds invoice lines that use it."
  },
  "source": {
    "base": {
      "src/money/format.ts": [
        "// Formats an amount in cents as US dollars, such as 1234 -> \"$12.34\".",
        "export function formatUsd(cents: number): string {",
        "  return `$${(cents / 100).toFixed(2)}`;",
        "}"
      ],
      "src/report/summary.ts": [
        "import { formatUsd } from '../money/format.ts';",
        "",
        "export interface LineItem {",
        "  label: string;",
        "  cents: number;",
        "}",
        "",
        "export function summaryLine(items: readonly LineItem[]): string {",
        "  const total = items.reduce((sum, item) => sum + item.cents, 0);",
        "  return `Total: ${formatUsd(total)}`;",
        "}"
      ]
    },
    "rounds": [
      {
        "number": 1,
        "trigger": "opened",
        "message": "Use Intl.NumberFormat for currency",
        "actions": [],
        "changes": {
          "src/money/format.ts": [
            "const usd = new Intl.NumberFormat('en-US', {",
            "  style: 'currency',",
            "  currency: 'USD',",
            "});",
            "",
            "// Formats a dollar amount, such as 12.34 -> \"$12.34\".",
            "export function formatUsd(dollars: number): string {",
            "  return usd.format(dollars);",
            "}"
          ],
          "src/report/invoice.ts": [
            "import { formatUsd } from '../money/format.ts';",
            "",
            "export function invoiceLine(label: string, dollars: number): string {",
            "  return `${label}: ${formatUsd(dollars)}`;",
            "}"
          ]
        }
      }
    ]
  },
