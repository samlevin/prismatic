  "source": {
    "base": {},
    "rounds": [
      {
        "number": 1,
        "trigger": "opened",
        "message": "Add page.Window",
        "actions": [],
        "changes": {
          "internal/page/page.go": [
            "package page",
            "",
            "// Window returns the items on a 1-based page of the given size. A page",
            "// past the end is empty.",
            "func Window(items []string, page, size int) []string {",
            "\tif page < 1 || size < 1 {",
            "\t\treturn nil",
            "\t}",
            "\tstart := page * size",
            "\tif start >= len(items) {",
            "\t\treturn nil",
            "\t}",
            "\tend := start + size",
            "\tif end > len(items) {",
            "\t\tend = len(items)",
            "\t}",
            "\treturn items[start:end]",
            "}"
          ]
        }
      },
      {
        "number": 2,
        "trigger": "synchronize",
        "message": "Fix the page offset",
        "actions": [],
        "changes": {
          "internal/page/page.go": [
            "package page",
            "",
            "// Window returns the items on a 1-based page of the given size. A page",
            "// past the end is empty.",
            "func Window(items []string, page, size int) []string {",
            "\tif page < 1 || size < 1 {",
            "\t\treturn nil",
            "\t}",
            "\tstart := (page - 1) * size",
            "\tif start >= len(items) {",
            "\t\treturn nil",
            "\t}",
            "\tend := start + size",
            "\tif end > len(items) {",
            "\t\tend = len(items)",
            "\t}",
            "\treturn items[start:end]",
            "}"
          ]
        }
      }
    ]
