    "title": "Add a retry helper for jobs",
    "body": "Adds retry() for background jobs and uses it in the scheduler."
  },
  "source": {
    "base": {},
    "rounds": [
      {
        "number": 1,
        "trigger": "opened",
        "message": "Add retry helper",
        "actions": [],
        "changes": {
          "src/jobs/retry.ts": [
            "export interface RetryOptions {",
            "  attempts: number;",
            "  delayMs: number;",
            "}",
            "",
            "// Runs the task until it succeeds or the attempts run out.",
            "export async function retry<T>(",
            "  task: () => Promise<T>,",
            "  options: RetryOptions,",
            "): Promise<T> {",
            "  let lastError: unknown;",
            "  for (let attempt = 0; attempt < options.attempts; attempt += 1) {",
            "    try {",
            "      return await task();",
            "    } catch (error) {",
            "      lastError = error;",
            "      if (attempt + 1 < options.attempts) {",
            "        await new Promise((resolve) => setTimeout(resolve, options.delayMs));",
            "      }",
            "    }",
            "  }",
            "  throw lastError;",
            "}"
          ]
        }
      },
      {
        "number": 2,
        "trigger": "synchronize",
        "message": "Use retry in the scheduler",
        "actions": [
          {
            "kind": "dismiss",
            "defect": "zero-attempts",
            "reason": "Every caller passes a constant attempt count."
          }
        ],
        "changes": {
          "src/jobs/schedule.ts": [
            "import { retry } from './retry.ts';",
            "",
            "export async function runNightly(job: () => Promise<void>): Promise<void> {",
            "  await retry(job, { attempts: 3, delayMs: 1000 });",
            "}"
          ]
        }
