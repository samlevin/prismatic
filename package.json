{
  "name": "prismatic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repository tooling for Prismatic: the issue workflow scripts and the generated agent workflows.",
  "engines": {
    "node": ">=22.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agents:generate": "node scripts/agent-policy.mjs generate",
    "agents:check": "node scripts/agent-policy.mjs check",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:md": "eslint --max-warnings 0 \"**/*.md\"",
    "test": "node --test scripts/*.test.mjs",
    "check": "npm run format:check && npm run lint && npm run agents:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "yaml": "^2.9.1"
  }
}
