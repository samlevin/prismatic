{
  "name": "prismatic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prismatic, a pull request review agent, in one package: product modules under src/, maintainer tooling, the issue workflow scripts, and the generated agent workflows.",
  "engines": {
    "node": ">=24.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "agents:generate": "node scripts/agent-policy.mjs generate",
    "agents:check": "node scripts/agent-policy.mjs check",
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --ignore-pattern '**/*.md'",
    "lint:md": "eslint --max-warnings 0 \"**/*.md\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:scripts && npm run test:unit",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:unit": "vitest run --coverage && node tooling/CoverageGate.ts coverage/coverage-summary.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run agents:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@types/estree": "1.0.9",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  }
}
